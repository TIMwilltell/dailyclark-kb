# Knowledge Base Environment Configuration
# Copy this file to .env and customize the paths for your setup

# Base path (usually your home directory)
BASE=/Users/yourusername/

# Content source paths (relative to BASE)
# These directories will be mounted into the Hugo site
DOCS_PATH=path/to/your/docs/
WORK_PATH=path/to/your/work/content/
RECIPES_PATH=path/to/your/recipes/

# Optional: Private content path (not currently used in docker-compose but defined)
PRIVATE_PATH=path/to/private/content/

# Development URLs (for OrbStack or similar local development)
# These are optional - the site will work at localhost:1313 without them
DEV_URL=kb.yourdomain.local
DEV_FB_URL=fb.yourdomain.local

# Edit URLs (optional - for linking to file browser)
BASE_EDIT_URL=http://localhost:1314/files

# Example paths (uncomment and modify as needed):
# DOCS_PATH=Documents/MyKnowledgeBase/
# WORK_PATH=Documents/WorkDocs/
# RECIPES_PATH=Documents/Recipes/
